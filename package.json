{
  "name": "@dativa-lv/lx-ui",
  "version": "0.0.1",
  "description": "LX/UI",
  "sideEffects": ["**/*.css", "**/*.vue"],
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/dativa-lv/lx-ui.git"
  },
  "homepage": "https://lx-ui.dev/",
  "files": [
    "dist",
    "dist/lx-fonts/*.woff",
    "dist/lx-fonts/*.ttf",
    "dist/vite",
    "dist/styles",
    "dist/bundles"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dativa-lv/lx-ui/issues"
  },
  "main": "./dist/dativa-lv-lx-ui.umd.js",
  "typings": "./dist/dativa-lv-lx-ui.d.ts",
  "module": "./dist/dativa-lv-lx-ui.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/dativa-lv-lx-ui.d.ts",
      "import": "./dist/dativa-lv-lx-ui.esm.js",
      "require": "./dist/dativa-lv-lx-ui.umd.js"
    },
    "./vite": {
      "import": "./dist/vite/dativa-lv-lx-ui-vite.es.js",
      "types": "./dist/types/vite/index.d.ts"
    },
    "./dist/styles/*": "./dist/styles/*",
    "./dist/bundles/*": "./dist/bundles/*",
    "./dist/lx-fonts/*": "./dist/lx-fonts/*"
  },
  "scripts": {
    "dev": "vite --host",
    "build:lib": "bun vite build --mode lib",
    "build:css": "bun vite build --mode css",
    "build:bundles": "bun scripts/build-bundles.mjs",
    "build:fonts": "bun vite build --mode fonts",
    "build:assets": "bun run build:css && bun run build:bundles && bun run build:fonts",
    "build:vite": "vite build --mode vite",
    "build": "bun run build:lib && bun run build:assets && bun run build:vite",
    "preview": "bun vite preview --mode lib",
    "lint": "eslint .",
    "test": "bun vitest --mode lib"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.0.0",
    "@contentauth/c2pa-web": "^0.15.3",
    "@floating-ui/vue": "^2.0.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-character-count": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/test-utils": "^2.4.3",
    "@vueuse/components": "15.0.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "axios": "1.20.0",
    "cyrillic-to-translit-js": "^3.2.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.16",
    "exifreader": "4.47.0",
    "focus-trap": "^8",
    "i18n-iso-countries": "^7.14.0",
    "jsrsasign": "11.1.5",
    "jszip": "^3.10.1",
    "marked": "^18.1.0",
    "mime": "^4.0.1",
    "pdfjs-dist": "^4.5.136",
    "qrcode.vue": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "v-money3": "3.26.1",
    "vue-country-flag-next": "^2.3.2",
    "vue-dompurify-html": "5.3.0",
    "vue-imask": "7.6.1",
    "vue-qrcode-reader": "^5.5.1",
    "vue-router": "5.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-airbnb": "8.0.0",
    "@zzdats/prettier-config": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "^9.20.1",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "5.0.3",
    "vue": "^3.5.17"
  },
  "overrides": {
    "markdown-it": "15.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.17"
  }
}
